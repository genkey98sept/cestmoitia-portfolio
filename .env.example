# Local PostgreSQL (Docker Compose). Keep the password/port aligned with DATABASE_URL.
POSTGRES_PASSWORD=change-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tia:change-local-db-password@127.0.0.1:5432/tia

# Payload CMS — Secret for encrypting tokens (must be a long, complex string)
PAYLOAD_SECRET=change-payload-secret

# Resend — Email API key (T9: contact form)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_NAME=Cestmoitia
ADMIN_EMAIL=cestmoitia@gmail.com

# Revalidation — Secret token for webhook (T10)
REVALIDATION_SECRET=change-revalidation-secret

# Vercel Blob — Storage token for media uploads (T11)
BLOB_READ_WRITE_TOKEN=

# Public — Site URL (exposed to client)
PORT=3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: select a Docker context without changing the global context.
# DOCKER_CONTEXT=colima

# Optional: reuse installed Google Chrome for browser tests (otherwise install Chromium).
# PLAYWRIGHT_CHANNEL=chrome

# Optional: path to the original portfolio media archive (absolute or relative).
# SEED_MEDIA_ROOT=/path/to/Portfolio 2026 maybe
