{
  "name": "tia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next start",
    "setup": "node scripts/setup.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:status": "node scripts/db.mjs status",
    "db:logs": "node scripts/db.mjs logs",
    "lint": "eslint . --max-warnings=0",
    "lint:architecture": "steiger src",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm generate && pnpm lint && pnpm lint:architecture && pnpm typecheck && pnpm test",
    "payload": "node --import ./scripts/load-env.mjs --import tsx node_modules/payload/bin.js",
    "generate": "pnpm generate:types && pnpm generate:importmap",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "db:migrate": "pnpm payload migrate",
    "db:migrate:create": "pnpm payload migrate:create",
    "db:migrate:status": "pnpm payload migrate:status",
    "seed": "tsx scripts/seed.ts",
    "seed:clean": "tsx scripts/seed.ts --clean",
    "seed:media": "tsx scripts/seed.ts --media-only",
    "seed:data": "tsx scripts/seed.ts --data-only",
    "seed:local": "tsx scripts/seed-local.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-force-exit tests/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-vercel-blob": "3.90.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "lenis": "1.3.26",
    "motion": "13.4.0",
    "next": "16.3.8",
    "payload": "3.90.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@next/env": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "steiger": "0.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": ">=10.34.5 <11"
  }
}
